Include /Users/mdas/.colima/ssh_config

Host tars
    # Pinned IP to skip the slow mDNS (.local) lookup. If the router ever
    # hands tars a different address, update this or restore tars.local.
    HostName 192.168.68.126
    User mdas
    IdentityFile ~/.ssh/id_ed25519
    AddressFamily inet

# External access over the Tailscale tailnet (works from any network, no open
# inbound ports). MagicDNS name is stable across IP changes; requires the
# Tailscale app running/connected on this Mac. Uses the same SSH key as LAN.
Host tars-ts
    HostName tars.tail1b1c58.ts.net
    User mdas
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 20
    ServerAliveCountMax 3
    TCPKeepAlive no

# Interactive external work over the tailnet: same tmux session ("main") as
# `tars-tmux`, so you can detach on the LAN and reattach from anywhere with
# processes still running. tmux survives the flakier external link across drops.
# Use `tars-ts` (plain) for scp/one-off commands.
Host tars-ts-tmux
    HostName tars.tail1b1c58.ts.net
    User mdas
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 20
    ServerAliveCountMax 3
    TCPKeepAlive no
    RequestTTY yes
    RemoteCommand tmux new-session -A -s main \; choose-tree -Zs
    # Detect a dead link (e.g. after the Mac sleeps) and exit cleanly
    # instead of hanging in a broken-pipe/raw-mode mess.
    ServerAliveInterval 20
    ServerAliveCountMax 3
    # Rely solely on the encrypted ServerAlive probe; disable the
    # unencrypted (spoofable) TCP-layer keepalive.
    TCPKeepAlive no

# Convenience alias: `ssh tars-tmux` attaches to tmux (creating session
# "main" if none exists) and lands on the interactive session picker —
# arrows + Enter to choose, q to stay in "main". Use this for interactive
# work; use `ssh tars` for scp/one-off commands.
Host tars-tmux
    HostName 192.168.68.126
    User mdas
    IdentityFile ~/.ssh/id_ed25519
    AddressFamily inet
    ServerAliveInterval 20
    ServerAliveCountMax 3
    TCPKeepAlive no
    RequestTTY yes
    RemoteCommand tmux new-session -A -s main \; choose-tree -Zs