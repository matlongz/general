#!/bin/sh
exec tail -n +3 $0
# Top-level GRUB entries: Server (CLI) and Desktop (GUI), rendered above
# 10_linux's "Advanced options" submenu. Both load the /vmlinuz + /initrd.img
# symlinks, which Debian re-points on kernel upgrade, so they survive kernel
# updates without regeneration.
#
# Desktop carries no systemd.unit=. An explicit systemd.unit= makes systemd boot
# that unit instead of resolving default.target, which bypasses
# systemd-system-update-generator and silently disables PackageKit offline
# updates. Server pins multi-user.target on purpose; offline updates are
# therefore Desktop-only. See README.md, "Why Desktop must not pin systemd.unit=".
#
# boot_profile=<mode> selects the runtime profile (boot_profile.sh), kept
# separate from systemd.unit= so the boot target and the profile stay
# independent. GRUB_CMDLINE_LINUX_DEFAULT carries boot_profile=desktop so
# 10_linux's Advanced entries, which also boot default.target, are marked too.
#
# 10_linux is locally patched to comment out its own top-level "simple" entry,
# which would otherwise duplicate Desktop. It is a dpkg conffile, so a
# grub-common upgrade can restore it; make-grub-entries.sh checks.
#
# Substituted per host by make-grub-entries.sh (underscores omitted here so this
# comment is not itself substituted): ROOT_UUID from `findmnt -no UUID /`, and
# EXTRA_CMDLINE from the env var of that name, e.g.
#   EXTRA_CMDLINE="resume=UUID=<fs> resume_offset=<N>"
#
# Assumes / and /boot on one partition (so /vmlinuz resolves), GPT, and ext*.
# Adjust the insmod/linux/initrd lines for a separate /boot, MBR, btrfs or LVM.
# These entries do not inherit GRUB_CMDLINE_LINUX; pass anything needed via
# EXTRA_CMDLINE.

menuentry 'Debian GNU/Linux Server' --class debian --class gnu-linux --class gnu --class os $menuentry_id_option 'gnulinux-server' {
	load_video
	insmod gzio
	insmod part_gpt
	insmod ext2
	search --no-floppy --fs-uuid --set=root __ROOT_UUID__
	echo 'Loading Linux (server -- multi-user.target) ...'
	linux /vmlinuz root=UUID=__ROOT_UUID__ ro quiet __EXTRA_CMDLINE__boot_profile=server systemd.unit=multi-user.target
	echo 'Loading initial ramdisk ...'
	initrd /initrd.img
}

menuentry 'Debian GNU/Linux Desktop' --class debian --class gnu-linux --class gnu --class os $menuentry_id_option 'gnulinux-desktop' {
	load_video
	insmod gzio
	insmod part_gpt
	insmod ext2
	search --no-floppy --fs-uuid --set=root __ROOT_UUID__
	echo 'Loading Linux (desktop -- default.target) ...'
	linux /vmlinuz root=UUID=__ROOT_UUID__ ro quiet __EXTRA_CMDLINE__boot_profile=desktop
	echo 'Loading initial ramdisk ...'
	initrd /initrd.img
}
