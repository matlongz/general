#!/bin/sh
# Pre-commit guard for the `general` dotfiles repo: never commit secrets or the
# machine-local rendered configs. Tracked in the repo and installed into
# .git/hooks by bootstrap.sh, so the protection is versioned across clones.
#
# Only ADDED/MODIFIED paths are inspected (--diff-filter=AM) so the legitimate
# `git rm --cached .ssh/config` DELETION in the templating migration is allowed.
set -eu

staged=$(git diff --cached --name-only --diff-filter=AM || true)

# 1. Block generated / secret-bearing repo-relative paths.
blocked=$(printf '%s\n' "$staged" | grep -E \
  '^(\.config/dotfiles/vars\.env|\.ssh/config|\.ssh/config\.bak|\.tmux\.conf|\.tmux\.conf\.bak)$' || true)
if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit local/generated file(s):" >&2
  printf '  %s\n' $blocked >&2
  echo "These are machine-local (rendered from templates / hold real data). Unstage them." >&2
  exit 1
fi

# 2. Block private-key material appearing in added/modified content.
if git diff --cached -U0 --diff-filter=AM | grep -Eq 'BEGIN (OPENSSH|RSA|EC|DSA|PGP) PRIVATE KEY'; then
  echo "pre-commit: refusing to commit — private key material detected in staged changes." >&2
  exit 1
fi

exit 0
