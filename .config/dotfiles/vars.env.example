# Copy to vars.env (same dir) and fill in ACTUAL values for THIS machine.
# vars.env is UNTRACKED (guarded by .git/info/exclude + the pre-commit hook) —
# it holds real data and must never be committed.
#
# Consumed by render.sh to fill the templates in templates/.

# SSH login user on the remote hosts.
SSH_USER=your-username

# Server's Tailscale (tailnet) IP — primary path for the `tars` / `tars-tmux`
# hosts; works from any network. Assigned once when the node joins the tailnet
# and never changes. Find it with: tailscale ip -4 tars
TARS_TS_IP=100.64.0.10

# Tailscale tailnet DNS suffix (e.g. tailXXXXXX.ts.net) — for the `tars-ts*`
# MagicDNS spellings. Find yours with: tailscale status --json | grep MagicDNSSuffix
TAILNET=tailXXXXXX.ts.net
